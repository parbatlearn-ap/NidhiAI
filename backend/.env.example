# Copy this file to ".env" (in the project root, one level up from
# backend/) and fill in your real values there.
# NEVER commit the real .env file - it's already in .gitignore.

# Groq API key (used for the AI/LLM features)
GROQ_API_KEY=your-groq-api-key-here

# Supabase project settings (find these in your Supabase project
# dashboard under Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-or-publishable-key-here
